# CineAgent Studio Configuration Variables

# Google Cloud AI Settings
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# ClickHouse Database Connection Settings
CLICKHOUSE_HOST=your_clickhouse_host_here.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_secure_clickhouse_password_here
CLICKHOUSE_SECURE=true
CLICKHOUSE_ALLOW_WRITE_ACCESS=true
